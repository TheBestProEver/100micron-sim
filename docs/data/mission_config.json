{
  "name": "mission_quarter_deck",
  "_comment": [
    "Four 0.5 x 0.5 x 1.5 in glass tubules on a quarter-space deck, simulated together from lift-off (T+0) through",
    "re-entry, parachute and splashdown (T+882 s) on one flight clock. Timeline: RockSat User Guide 2026 Table 3-1, plus",
    "fact-sheet analogs and derived estimates (see dolle_sim/flight.py). Dust materials, sizes, counts and",
    "positions are EXAMPLES: replace them with the team's actual powders, glass and layout. The quarter",
    "space is a semicircle of the ~12 in deck (radius ~6 in = 0.152 m), 5.00 in high.",
    "The microgravity window is T+88 to T+313 s (100 km crossings); impact statistics are counted only inside it.",
    "Runs end 5 s after splashdown; the top-level key simulate_to_s stops them earlier (e.g. 332 for power-off).",
    "Scenarios compare the undecided design choices; run one with --scenario NAME, or combine them with '+'",
    "(e.g. --scenario kick+lying). The default release (a 50 g shaker) frees no dust, so compare gas, orientation",
    "and spin on top of a release that does (kick+gas_1atm, kick+lying, ...)."
  ],
  "simulate_from_s": 0.0,
  "dt_s": 0.004,
  "dt_launch_s": 0.0005,
  "output_fps": 4,
  "seed": 7,
  "flight_profile": {
    "burn1": [0.0, 5.2],
    "burn2": [17.4, 29.1],
    "burn_g": 25.0,
    "coast_drag_g": 3.0,
    "post_burn_drag_g": 3.0,
    "spin_burnout_hz": 4.8,
    "despin_s": 54.0,
    "despin_duration_s": 0.9,
    "residual_spin_hz": 0.0167,
    "residual_g": 0.0001,
    "ug_start_s": 88.0,
    "power_off_s": 332.0,
    "chute_s": 460.0,
    "splash_s": 882.0,
    "chute_altitude_m": 4600.0,
    "opening_peak_g": 5.0,
    "descent_attitude": "broadside",
    "hang_attitude": "nose_down",
    "float_attitude": "side",
    "_comment": "descent and attitudes: see dolle_sim/flight.py"
  },
  "gas": {"pressure_pa": 0.001, "gas": "air", "temperature_k": 293.0},
  "forces": {"long_range_update_every": 1},
  "contact": {"friction_coefficient": 0.3, "contact_charging": true, "fragmentation": true},
  "camera": {"fps": 500, "position_noise_m": 5e-6, "track_frames": 6,
             "_comment": "view axis, field of view and depth of field are set per tubule from its orientation"},
  "tubules": [
    {"name": "T1_silica_90-106um_bare", "inner_size_in": [0.5, 0.5, 1.5], "orientation": "standing",
     "deck_position_m": [-0.080, 0.050], "wall_material": "glass_borosilicate", "wall_adhesion_factor": 1.0,
     "dust": {"material": "silica", "count": 800, "surface_energy_log_sigma": 0.6,
              "size_distribution": {"type": "sieve", "min_m": 9.0e-5, "max_m": 1.06e-4, "fraction_in_range": 0.9}},
     "release": [{"type": "shake", "start_s": 90.0, "duration_s": 10.0, "frequency_hz": 200, "peak_g": 50.0, "axis": "z"}]},
    {"name": "T2_graphite_90-106um_bare", "inner_size_in": [0.5, 0.5, 1.5], "orientation": "standing",
     "deck_position_m": [-0.030, 0.065], "wall_material": "glass_borosilicate", "wall_adhesion_factor": 1.0,
     "dust": {"material": "graphite", "count": 800, "surface_energy_log_sigma": 0.6,
              "size_distribution": {"type": "sieve", "min_m": 9.0e-5, "max_m": 1.06e-4, "fraction_in_range": 0.9}},
     "release": [{"type": "shake", "start_s": 90.0, "duration_s": 10.0, "frequency_hz": 200, "peak_g": 50.0, "axis": "z"}]},
    {"name": "T3_silica_45-53um_silanized", "inner_size_in": [0.5, 0.5, 1.5], "orientation": "standing",
     "deck_position_m": [0.030, 0.065], "wall_material": "glass_silanized", "wall_adhesion_factor": 1.0,
     "dust": {"material": "silica", "count": 800, "surface_energy_log_sigma": 0.6,
              "size_distribution": {"type": "sieve", "min_m": 4.5e-5, "max_m": 5.3e-5, "fraction_in_range": 0.9}},
     "release": [{"type": "shake", "start_s": 90.0, "duration_s": 10.0, "frequency_hz": 200, "peak_g": 50.0, "axis": "z"}]},
    {"name": "T4_graphite_45-53um_silanized", "inner_size_in": [0.5, 0.5, 1.5], "orientation": "standing",
     "deck_position_m": [0.080, 0.050], "wall_material": "glass_silanized", "wall_adhesion_factor": 1.0,
     "dust": {"material": "graphite", "count": 800, "surface_energy_log_sigma": 0.6,
              "size_distribution": {"type": "sieve", "min_m": 4.5e-5, "max_m": 5.3e-5, "fraction_in_range": 0.9}},
     "release": [{"type": "shake", "start_s": 90.0, "duration_s": 10.0, "frequency_hz": 200, "peak_g": 50.0, "axis": "z"}]}
  ],
  "scenarios": {
    "no_release": {"tubules": {"release": []}},
    "kick": {"tubules": {"release": [
      {"type": "kick", "start_s": 90.0, "cycles": 1, "frequency_hz": 5000, "peak_g": 5000.0, "axis": "z"},
      {"type": "kick", "start_s": 150.0, "cycles": 1, "frequency_hz": 5000, "peak_g": 5000.0, "axis": "z"},
      {"type": "kick", "start_s": 210.0, "cycles": 1, "frequency_hz": 5000, "peak_g": 5000.0, "axis": "z"}]}},
    "strong_shaker": {"tubules": {"release": [
      {"type": "shake", "start_s": 90.0, "duration_s": 5.0, "frequency_hz": 1000, "peak_g": 500.0, "axis": "z"}]}},
    "rough_grains": {"tubules": {"wall_adhesion_factor": 0.02}},
    "lying": {"tubules": {"orientation": "lying"}},
    "gas_100pa": {"gas": {"pressure_pa": 100.0}},
    "gas_1atm": {"gas": {"pressure_pa": 101325.0}},
    "spin_1hz": {"flight_profile": {"residual_spin_hz": 1.0}},
    "no_drag": {"flight_profile": {"coast_drag_g": 0.0, "post_burn_drag_g": 0.0}},
    "descent_tumbling": {"flight_profile": {"descent_attitude": "tumbling"}},
    "hang_nose_up": {"flight_profile": {"hang_attitude": "nose_up", "float_attitude": "nose_up"}},
    "shock_oblique": {"flight_profile": {"shock_direction": "oblique"}}
  }
}
